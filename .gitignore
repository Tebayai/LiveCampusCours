# ==========================================

/node_modules/
/npm-debug.log*
/yarn-debug.log*
/pnpm-debug.log*

# Fichiers de build
/dist/
/build/

# Cache des outils JS
/.eslintcache
/.stylelintcache
/.parcel-cache/
/.vite/

