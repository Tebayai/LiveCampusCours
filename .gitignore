*~

# ==========================================
# PHP / Composer
# ==========================================

/vendor/

# Fichiers de configuration locaux
.env.local
.env.*.local

# Fichiers de logs
/var/log/
*.log

# Cache Symfony
/var/cache/

# Sessions PHP
*.sess

